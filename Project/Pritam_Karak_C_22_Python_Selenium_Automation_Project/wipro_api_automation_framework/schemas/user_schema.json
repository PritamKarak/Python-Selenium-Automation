{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "username", "email", "address", "phone", "website", "company"],
  "properties": {
    "id": {"type": "integer"},
    "name": {"type": "string"},
    "username": {"type": "string"},
    "email": {"type": "string", "format": "email"},
    "address": {"type": "object"},
    "phone": {"type": "string"},
    "website": {"type": "string"},
    "company": {"type": "object"}
  }
}
